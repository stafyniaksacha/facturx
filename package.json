{
  "name": "@stafyniaksacha/facturx",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@9.10.0",
  "description": "Factur-X and Order-X generation library for European e-invoicing standard",
  "license": "MIT",
  "repository": "stafyniaksacha/facturx",
  "keywords": [
    "factur-x",
    "order-x",
    "e-invoicing",
    "pdf",
    "xml",
    "european",
    "en16931"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./models": {
      "types": "./dist/models.d.mts",
      "import": "./dist/models.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "bin": {
    "facturx": "./bin/facturx.mjs"
  },
  "files": [
    "bin",
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "prepack": "unbuild",
    "dev:prepare": "unbuild --stub",
    "dev": "vitest",
    "build": "unbuild",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "citty": "^0.1.6",
    "date-fns": "^4.1.0",
    "libxmljs": "^1.0.11",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.18.0",
    "@types/node": "^22.16.5",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "unbuild": "^3.6.0",
    "vitest": "^3.2.4"
  }
}
